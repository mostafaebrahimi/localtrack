{
  "name": "localtrack",
  "version": "1.0.0",
  "private": true,
  "description": "LocalTrack — 100% local-first personal time & activity tracker",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:desktop": "pnpm --filter @localtrack/desktop tauri dev",
    "build:desktop": "pnpm --filter @localtrack/desktop tauri build",
    "build:extension": "pnpm --filter @localtrack/chrome-extension build",
    "rust:fmt": "cargo fmt --all",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.2"
}
