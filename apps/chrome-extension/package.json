{
  "name": "@localtrack/chrome-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts && node scripts/finalize.mjs",
    "build:firefox": "tsc --noEmit && vite build --outDir dist-firefox && vite build --config vite.content.config.ts --outDir dist-firefox && LOCALTRACK_BROWSER=firefox LOCALTRACK_DIST=dist-firefox node scripts/finalize.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork"
  },
  "dependencies": {
    "@localtrack/protocol": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
