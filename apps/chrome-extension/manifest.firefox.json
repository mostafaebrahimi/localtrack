{
  "manifest_version": 3,
  "name": "LocalTrack",
  "version": "1.0.0",
  "description": "Local-first time tracking. Sends browser activity to the LocalTrack desktop application on this computer only.",
  "browser_specific_settings": {
    "gecko": {
      "id": "localtrack@localtrack.app",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LocalTrack",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "webNavigation", "nativeMessaging", "storage", "alarms", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
